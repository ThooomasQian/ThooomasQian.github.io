{
  "name": "guanyue-academic-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.github.config.ts",
    "build": "pnpm build:github",
    "build:github": "vite build --config vite.github.config.ts && vite build --config vite.github.ssr.config.ts && node scripts/prerender-github.mjs",
    "test": "pnpm build:github && pnpm test:github",
    "test:github": "node --test tests/github-pages.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
